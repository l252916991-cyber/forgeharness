# Tests and control evaluation need no key. The repair CLI reads this value.
FORGE_API_KEY=
FORGE_SERVICE_API_KEY=
FORGE_ENABLE_OMLX=false
FORGE_OMLX_BASE_URL=http://127.0.0.1:8000/v1
FORGE_CHAT_MODEL=Qwen3.5-9B-4bit
FORGE_EMBEDDING_MODEL=Qwen3-Embedding-4B-4bit-DWQ
FORGE_RERANKER_MODEL=bge-reranker-v2-m3-mlx
FORGE_POSTGRES_DSN=
FORGE_REDIS_URL=
FORGE_QDRANT_URL=
FORGE_DATA_DIR=.forgeharness
