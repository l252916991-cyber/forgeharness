# Verification evidence: commit the human-readable reports and top-level
# evaluation results only. Raw run data (PostgreSQL data directories, SQLite
# state, frozen source copies, logs) stays local and is regenerated by the gates.
/reports/**
!/reports/**/
!/reports/*.md
!/reports/*/*.md
!/reports/*/*/*.md
!/reports/*.json
/reports/*coverage*.json

# Pre-change snapshots of README/docs taken by improvement runs; kept locally.
/reports/*/before/
